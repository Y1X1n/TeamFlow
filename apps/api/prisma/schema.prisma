generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_COMMENTED
  TASK_UPDATED
  COMMENT_REPLY
  COMMENT_REACTION
  MENTION
  TASK_DUE_SOON
  TASK_OVERDUE
  MEMBER_JOINED
  MEMBER_REMOVED
  ROLE_CHANGED
  WEEKLY_REPORT
  INVITE
}

enum ActivityType {
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_UNARCHIVED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_ROLE_CHANGED
  MEMBER_PERMISSIONS_CHANGED
  COLUMN_CREATED
  COLUMN_UPDATED
  COLUMN_DELETED
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_ASSIGNED
  TASK_DELETED
  TASK_RESTORED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_DELETED
  REPORT_GENERATED
  REPORT_EMAIL_SENT
  TASK_DEPENDENCY_ADDED
  TASK_DEPENDENCY_REMOVED
  MEMBER_SKILLS_CHANGED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens  RefreshToken[]
  memberships    ProjectMember[]
  ownedProjects  Project[]       @relation("ProjectOwner")
  createdTasks   Task[]          @relation("TaskCreator")
  assignedTasks  Task[]          @relation("TaskAssignee")
  comments       TaskComment[]
  attachments    Attachment[]
  notifications  Notification[]
  activities     Activity[]      @relation("ActivityActor")
  invitesCreated ProjectInvite[] @relation("InviteCreator")
  reportsCreated WeeklyReport[]  @relation("ReportCreator")

  commentReactions        CommentReaction[]
  taskWatchers            TaskWatcher[]
  notificationPreferences NotificationPreference[]
  createdTaskDependencies TaskDependency[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String    @default("#6366F1")
  ownerId     String    @map("owner_id")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members    ProjectMember[]
  invites    ProjectInvite[]
  columns    BoardColumn[]
  tasks      Task[]
  activities Activity[]
  reports    WeeklyReport[]

  @@index([ownerId])
  @@index([archivedAt])
  @@map("projects")
}

model ProjectMember {
  id                  String      @id @default(cuid())
  projectId           String      @map("project_id")
  userId              String      @map("user_id")
  role                ProjectRole @default(MEMBER)
  permissionOverrides Json?       @map("permission_overrides")
  skills              String[]    @default([])
  joinedAt            DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectInvite {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  email       String
  role        ProjectRole
  tokenHash   String      @unique @map("token_hash")
  invitedById String      @map("invited_by_id")
  expiresAt   DateTime    @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?   @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([projectId, email])
  @@index([expiresAt])
  @@map("project_invites")
}

model BoardColumn {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  position  String
  isDone    Boolean  @default(false) @map("is_done")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, position])
  @@map("board_columns")
}

model Task {
  id              String       @id @default(cuid())
  projectId       String       @map("project_id")
  columnId        String       @map("column_id")
  title           String
  description     Json?
  priority        TaskPriority @default(MEDIUM)
  assigneeId      String?      @map("assignee_id")
  createdById     String       @map("created_by_id")
  dueDate         DateTime?    @map("due_date") @db.Timestamptz(3)
  estimateMinutes Int?         @map("estimate_minutes")
  actualMinutes   Int?         @map("actual_minutes")
  recurrence      TaskRecurrence @default(NONE)
  recurrenceGeneratedAt DateTime? @map("recurrence_generated_at") @db.Timestamptz(3)
  labels          String[]     @default([])
  position        String
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(3)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  project               Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  column                BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Restrict)
  assignee              User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy             User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments              TaskComment[]
  attachments           Attachment[]
  subtasks              TaskSubtask[]
  watchers              TaskWatcher[]
  blockedByDependencies TaskDependency[] @relation("TaskDependent")
  blockingDependencies  TaskDependency[] @relation("TaskBlocker")

  @@index([projectId, deletedAt, columnId, position], map: "tasks_board_idx")
  @@index([assigneeId, deletedAt, completedAt], map: "tasks_assignee_idx")
  @@index([dueDate, completedAt, deletedAt], map: "tasks_due_idx")
  @@map("tasks")
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String    @map("task_id")
  authorId  String    @map("author_id")
  parentId  String?   @map("parent_id")
  body      Json
  bodyText  String    @map("body_text")
  mentions  String[]  @default([])
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  task      Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent    TaskComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[]     @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([taskId, createdAt])
  @@index([parentId])
  @@map("task_comments")
}

model TaskSubtask {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  title     String
  isDone    Boolean  @default(false) @map("is_done")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
  @@map("task_subtasks")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@map("comment_reactions")
}

model TaskWatcher {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  enabled   Boolean          @default(true)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model Attachment {
  id           String   @id @default(cuid())
  taskId       String   @map("task_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  objectKey    String   @unique @map("object_key")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task       Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@map("attachments")
}

model Activity {
  id        String       @id @default(cuid())
  projectId String       @map("project_id")
  actorId   String?      @map("actor_id")
  taskId    String?      @map("task_id")
  type      ActivityType
  payload   Json
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "activities_project_idx")
  @@index([taskId])
  @@map("activities")
}

model TaskDependency {
  id          String   @id @default(cuid())
  taskId      String   @map("task_id")
  blockedById String   @map("blocked_by_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task      Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  blockedBy Task @relation("TaskBlocker", fields: [blockedById], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([taskId, blockedById])
  @@index([blockedById])
  @@map("task_dependencies")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  payload   Json
  dedupeKey String?          @map("dedupe_key")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)], map: "notifications_user_idx")
  @@map("notifications")
}

model WeeklyReport {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  weekStart   DateTime @map("week_start") @db.Date
  weekEnd     DateTime @map("week_end") @db.Date
  data        Json
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([projectId, weekStart])
  @@map("weekly_reports")
}
