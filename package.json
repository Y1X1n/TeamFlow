{
  "name": "teamflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @teamflow/shared build && pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:lint": "redocly lint docs/openapi.yaml",
    "db:migrate": "pnpm --filter @teamflow/api db:migrate",
    "db:deploy": "pnpm --filter @teamflow/api db:deploy",
    "db:seed": "pnpm --filter @teamflow/api db:seed"
  },
  "devDependencies": {
    "@redocly/cli": "^1.25.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
