# ---- API ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
REALTIME_PORT=1235
DATABASE_URL=postgresql://teamflow:teamflow@localhost:55432/teamflow?schema=public
REDIS_URL=redis://localhost:6380
# 本地开发占位值；生产环境必须替换为随机值（compose 会强制要求注入），
# 例如：openssl rand -hex 32
JWT_SECRET=dev-only-change-me-please-32-bytes-minimum
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
# 反向代理层数；直连 API 时保持 0，经 Nginx/负载均衡时设为 1（compose 已默认 1）
TRUST_PROXY=0
CORS_ORIGINS=http://localhost:3000,http://localhost
TZ=Asia/Shanghai
API_PUBLIC_URL=http://localhost:4000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teamflow
S3_FORCE_PATH_STYLE=true
SENTRY_DSN=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=20000
# 仅本地开发可设为 true，允许 AI_BASE_URL 指向 loopback（127.0.0.1/::1/localhost）；
# 生产环境始终拒绝 loopback、私有与保留地址。
AI_ALLOW_LOOPBACK=false
# 腾讯 Agent Mail（周报智能邮件，可选）
AGENT_MAIL_ENABLED=false
# 指向 @tencent-qqmail/agently-cli/scripts/run.js 的绝对路径；也可安装后保留空以使用 PATH
AGENT_MAIL_CLI_ENTRY=
LOG_LEVEL=info
WORKER_ONLY=false
ENABLE_REALTIME=true
ENABLE_JOBS=true

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:1235
NEXT_PUBLIC_SENTRY_DSN=
# 演示账号提示（可选，留空则登录页不展示）。格式：Alice:alice@example.com,Bob:bob@example.com
NEXT_PUBLIC_DEMO_ACCOUNTS=
NEXT_PUBLIC_DEMO_PASSWORD=
